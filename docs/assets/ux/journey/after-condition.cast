[1.241745, "o", "\u001b[1;18H\u001b[38;2;196;169;255;1m  /  Cek kondisi PC\u001b[m   \u001b[38;2;155;174;201m[•_•] [=]  Piko\u001b[m\r\n\n  \u001b[38;2;103;232;249;1mCek kondisi PC\u001b[m\u001b[K\r\n\n  \u001b[38;2;226;232;240mLihat kondisi komponen dan saran perawatan.\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mCakupan CPU, memori, disk, SSD, TRIM, dan daya.\u001b[m\r\n  \u001b[38;2;226;232;240mAkses admin baca hingga 10 menit · SSD / SMART, TRIM dan bukti, CPU dan\u001b[m\r\n  \u001b[38;2;226;232;240mdaya, Sensor suhu CPU\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mIzin batal/ditolak → lanjut dengan akses biasa.\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mPerubahan sistem ditinjau terpisah.\u001b[m\u001b[K\r\n\u001b[K\n  \u001b[38;2;226;232;240m  Mulai dengan izin administrator\u001b[m\r\n  \u001b[38;2;103;232;249;48;2;35;53;76;1m› Mulai tanpa administrator\u001b[m\u001b[K\r\n\n  \u001b[38;2;155;174;201m↑↓ Pilih akses  ·  Enter Mulai  ·  Esc Kembali\u001b[m"]
