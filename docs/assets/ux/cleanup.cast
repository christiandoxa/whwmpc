[0.471931, "o", "\u001b[1;18H\u001b[38;2;196;169;255;1m  /  Bersihkan ruang\u001b[m   \u001b[38;2;155;174;201m[•ᴗ•] Piko\u001b[m\r\n\n  \u001b[38;2;103;232;249;1mAPT (fixture) · Tersedia\u001b[m\r\n\n  \u001b[38;2;226;232;240m376 MiB · 19 file teramati\u001b[m\r\n  \u001b[38;2;226;232;240mFixture cache removal may require downloading packages again.\u001b[m\r\n  \u001b[38;2;226;232;240mPaket yang sudah terpasang tetap tersedia. Isi cache yang dihapus perlu\u001b[m\r\n  \u001b[38;2;226;232;240mdiunduh ulang.\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mSeluruh kategori cache APT. Penghapusan permanen.\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mDEMO · tindakan terkunci.\u001b[m\r\n\n  \u001b[38;2;103;232;249;48;2;35;53;76;1m› Tinjau seluruh cache APT\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240m  Lihat semua hasil\u001b[m\r\n  \u001b[38;2;226;232;240m  Kembali\u001b[m\r\n\n  \u001b[38;2;155;174;201m↑↓ Pilih  ·  Enter Buka  ·  Esc Kembali  ·  ? Bantuan\u001b[m"]
[0.687746, "o", "\u001b[1;43H\u001b[38;2;155;174;201m_•\u001b[m\r\n\n  \u001b[38;2;103;232;249;1mBersihkan cache paket\u001b[m\u001b[K\r\n\n  \u001b[38;2;226;232;240mTarget · Cache APT (fixture)\u001b[m\r\n  \u001b[38;2;226;232;240mSebelum · /var/cache/apt/archives dan indeks cache (fixture)\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mSesudah · cache paket dalam cakupan dihapus permanen\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mDampak · Berkas cache akan diunduh lagi saat diperlukan.\u001b[m\r\n  \u001b[38;2;226;232;240mRisiko · Penghapusan permanen pada aksi nyata. Demo terkunci.\u001b[m\r\n  \u001b[38;2;226;232;240mIzin · Administrator melalui sudo\u001b[m\r\n  \u001b[38;2;226;232;240mPemulihan · Tidak bisa dipulihkan\u001b[m\r\n  \u001b[38;2;226;232;240mEstimasi teramati · 376 MiB\u001b[m\r\n\u001b[K\n  \u001b[38;2;103;232;249;48;2;35;53;76;1m› Kembali\u001b[m\r\n  \u001b[38;2;226;232;240m  Bersihkan cache paket · DEMO\u001b[m\r\n\u001b[K\n  \u001b[38;2;155;174;201mDEMO · Aksi terkunci · Esc Kembali\u001b[m"]
[0.904951, "o", "\r\u001b[J\u001b[1;43H\u001b[38;2;155;174;201mᴗ•\u001b[m\r\n\n  \u001b[38;2;103;232;249;1mAPT (fixture) · Tersedia\u001b[m\r\n\n  \u001b[38;2;226;232;240m376 MiB · 19 file teramati\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mFixture cache removal may require downloading packages again.\u001b[m\r\n  \u001b[38;2;226;232;240mPaket yang sudah terpasang tetap tersedia. Isi cache yang dihapus perlu\u001b[m\r\n  \u001b[38;2;226;232;240mdiunduh ulang.\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mSeluruh kategori cache APT. Penghapusan permanen.\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mDEMO · tindakan terkunci.\u001b[m\u001b[K\r\n\u001b[K\n  \u001b[38;2;103;232;249;48;2;35;53;76;1m› Tinjau seluruh cache APT\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240m  Lihat semua hasil\u001b[m\r\n  \u001b[38;2;226;232;240m  Kembali\u001b[m\r\n\u001b[K\n  \u001b[38;2;155;174;201m↑↓ Pilih  ·  Enter Buka  ·  Esc Kembali  ·  ? Bantuan\u001b[m"]
