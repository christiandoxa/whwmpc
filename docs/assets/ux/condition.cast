[0.255985, "o", "\u001b[3;3H\u001b[38;2;103;232;249;1mSemua hasil\u001b[m\u001b[K\r\n\n  \u001b[38;2;226;232;240mCPU, memori, dan penyimpanan · Tersedia\u001b[m\r\n  \u001b[38;2;226;232;240mRuang simpan · Tersedia\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mDaya dan performa · Tersedia\u001b[m\r\n  \u001b[38;2;226;232;240mKesehatan SSD · Tersedia\u001b[m\u001b[K\r\n  \u001b[38;2;226;232;240mPerawatan SSD · Tersedia\u001b[m\r\n\u001b[K\n  \u001b[38;2;226;232;240mBeban prosesor · sampel tercatat\u001b[m\r\n  \u001b[38;2;226;232;240mCPU 13–38% pada 8 sampel.\u001b[m\r\n  \u001b[38;2;226;232;240mPersentase ini menggabungkan semua CPU logis.\u001b[m\r\n  \u001b[38;2;226;232;240mSaran · Ambil sampel saat gejala berlangsung untuk membandingkan beban.\u001b[m\r\n  \u001b[38;2;226;232;240mSumber · /proc/stat · 2026-11-22 09:41 UTC\u001b[m\r\n  \u001b[38;2;226;232;240mBatas · Jendela ini singkat. Beban satu inti dapat tersembunyi di angka\u001b[m\r\n  \u001b[38;2;226;232;240mgabungan.\u001b[m\r\n\n  \u001b[38;2;226;232;240mMemori · sampel tercatat\u001b[m\r\n  \u001b[38;2;155;174;201m1–17 / 179\u001b[m\r\n\n  \u001b[38;2;155;174;201m↑↓ Gulir  ·  Enter Pilihan lanjutan  ·  Esc Kembali\u001b[m"]
